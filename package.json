  "homepage": "https://github.com/T1ckbase/tw-zipcode-data#readme",
  "bugs": {
    "url": "https://github.com/T1ckbase/tw-zipcode-data/issues"
  },
  "license": "MIT",
  "author": {
    "name": "T1ckbase",
    "email": "146760065+T1ckbase@users.noreply.github.com",
    "url": "https://github.com/T1ckbase"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T1ckbase/tw-zipcode-data.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
